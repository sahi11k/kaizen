# Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Frontend-safe Supabase publishable key only. Do not use sb_secret_ keys here.
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# Set to true when running Vite in WSL and file watching needs polling.
VITE_WSL=false
